# Copy to .env.local and set to your API Gateway invoke URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://ahjqugrd7i.execute-api.ap-south-1.amazonaws.com

# Optional: "Continue with Google" on the admin login and registration (the OAuth web
# client ID; see backend-api/README.md → Adding Google sign-in). Leave empty to hide it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
